POSTGRES_HOST=10.254.100.50
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sea
POSTGRES_SCHEMA=sea

# Optional, for `make db-diff`/`make db-apply`/`make db-status` against the
# compose db service published on host port 5440
# MATRIX_WHALE_DATABASE_URL=postgres://user:pass@localhost:5440/sea?sslmode=disable

# NWS requires a contact email in the User-Agent header for api.weather.gov requests
NOAA_CONTACT_EMAIL=

# Optional User-Agent contact for the USGS earthquake feed
USGS_CONTACT_EMAIL=
# Empty stores all magnitudes; set a number only to filter before core ingestion
USGS_MIN_MAG=

# Optional User-Agent contact for the EMSC real-time earthquake feed
EMSC_CONTACT_EMAIL=
